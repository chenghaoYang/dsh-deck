{
  "name": "dsh-deck",
  "version": "0.1.0",
  "description": "A terminal-native multi-agent cockpit for DeepSeek Harness. Many agents, one screen, built for Ghostty.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "tui",
    "ghostty",
    "ai-agents",
    "terminal"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenghaoYang/dsh-deck.git"
  },
  "homepage": "https://github.com/chenghaoYang/dsh-deck#readme",
  "bugs": {
    "url": "https://github.com/chenghaoYang/dsh-deck/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "deck": "./bin/deck.js",
    "dsh-deck": "./bin/deck.js"
  },
  "exports": {
    ".": "./lib/src/index.js"
  },
  "files": [
    "bin",
    "lib/src",
    "!lib/src/dev",
    "docs/screenshots/dsh-deck-ghostty.png",
    "LICENSE",
    "SPEC.md",
    "README.md",
    "README.zh-CN.md"
  ],
  "//": "scripts/ is intentionally not published: pty-bridge.py and verify-live.mjs are development tools, not runtime dependencies.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "start": "node --experimental-strip-types src/cli.ts",
    "dev": "node --experimental-strip-types --watch src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "fake-llm": "node --experimental-strip-types src/dev/fake-llm.ts",
    "preview": "node --experimental-strip-types src/dev/preview.ts",
    "e2e": "node --experimental-strip-types scripts/e2e.mjs",
    "verify": "node --experimental-strip-types scripts/verify-live.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3"
  }
}
